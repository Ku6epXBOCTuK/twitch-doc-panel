{
	"name": "twitch-panel-bio",
	"private": true,
	"type": "module",
	"version": "0.2.0",
	"scripts": {
		"dev": "vite",
		"build:viewer": "vite build -c vite.build.viewer.js",
		"build:config": "vite build -c vite.build.config.js",
		"build": "npm run build:viewer && npm run build:config && node scripts/pack.js",
		"build:fixtures": "node builder/build.js content/docs",
		"install-cli": "node scripts/install-cli.js",
		"assets": "node scripts/assets.js",
		"screenshots": "node scripts/screenshot.js",
		"format": "prettier --write . --log-level=warn"
	},
	"dependencies": {
		"gray-matter": "^4.0.3",
		"marked": "^12.0.0"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"prettier": "^3.9.8",
		"svelte": "^5.0.0",
		"vite": "^6.0.0",
		"vite-plugin-singlefile": "^2.0.3"
	}
}
