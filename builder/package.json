{
	"name": "@ku6epxboctuk/twitch-doc-panel-builder",
	"version": "0.1.0",
	"description": "Build Twitch Doc Panel document indexes from Markdown files.",
	"type": "module",
	"bin": {
		"twitch-doc-panel-builder": "./dist/build.js"
	},
	"exports": {
		".": {
			"types": "./dist/builder/build.d.ts",
			"import": "./dist/build.js"
		}
	},
	"main": "./dist/build.js",
	"types": "./dist/builder/build.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "node build.mjs",
		"prepack": "npm run build"
	},
	"dependencies": {
		"gray-matter": "^4.0.3",
		"marked": "^12.0.0"
	},
	"engines": {
		"node": ">=18"
	},
	"license": "MIT",
	"author": "Ku6epXBOCTuK",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Ku6epXBOCTuK/twitch-doc-panel.git",
		"directory": "builder"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
