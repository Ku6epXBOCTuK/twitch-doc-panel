{
	"name": "twitch-panel-bio",
	"private": true,
	"type": "module",
	"version": "0.2.0",
	"scripts": {
		"dev": "vite",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"build:viewer": "vite build -c vite.build.viewer.ts",
		"build:config": "vite build -c vite.build.config.ts",
		"build": "npm run build:viewer && npm run build:config && node scripts/pack.ts",
		"build:fixtures": "node builder/build.ts content/docs",
		"install-cli": "node scripts/install-cli.ts",
		"assets": "node scripts/assets.ts",
		"screenshots": "node scripts/screenshot.ts",
		"format": "prettier --write . --log-level=warn"
	},
	"dependencies": {
		"gray-matter": "^4.0.3",
		"marked": "^12.0.0"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@types/node": "^26.6.2",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.0.0",
		"svelte-check": "^4.7.6",
		"typescript": "^5.9.3",
		"vite": "^6.0.0",
		"vite-plugin-singlefile": "^2.0.3"
	}
}
